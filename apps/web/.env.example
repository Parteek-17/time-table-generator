# Auth.js session encryption. Generate with: npx auth secret   (or any 32+ random bytes)
AUTH_SECRET="dev-only-change-me-auth-secret-0123456789abcdef"
# Sign-in links must point at the subdomain the user is on, so trust the Host header.
# Leave AUTH_URL unset for the same reason.
AUTH_TRUST_HOST=true

# Restricted app role (same as apps/api). Auth.js stores users and sessions here.
DATABASE_URL="postgresql://slotwise_app:slotwise_app@localhost:5432/slotwise"

# Sign-in emails. Dev: Mailpit (http://localhost:8025).
# Production: smtp://resend:<RESEND_API_KEY>@smtp.resend.com:587
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Slotwise <no-reply@slotwise.test>"

# Optional: Google sign-in. Leave empty to hide the button.
# Redirect URI to register: http://demo.localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# The API, and the secret shared with it (must match apps/api/.env).
API_URL="http://localhost:4000"
API_JWT_SECRET="dev-only-change-me-0123456789abcdef0123456789"

# Institutes are <slug>.<WEB_ROOT_DOMAIN>. Production: slotwise.app
WEB_ROOT_DOMAIN="localhost"

# Feature flags per stream (packages/shared/src/flags.ts). Unset: on in development, off in
# production. 1 = on, 0 = off. Keep them the same as in apps/api/.env.
# FLAG_UI=1
# FLAG_P2T=1
# FLAG_P4=1
# FLAG_P5=1
# FLAG_P6=1
# FLAG_P7=1

# One-click sign-in for the fictional demo accounts (/demo-login), for evaluations only.
# Never set this on a site with real users.
DEMO_LOGINS="false"

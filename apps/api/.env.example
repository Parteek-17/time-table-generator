# Port for local dev. In production leave unset; the host's PORT is used.
API_PORT=4000

# Restricted app role: row-level security applies. Never use the owner role here;
# the API refuses to start if you do.
DATABASE_URL="postgresql://slotwise_app:slotwise_app@localhost:5432/slotwise"

# Shared with apps/web. The web signs short-lived JWTs with it; the API verifies them.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_JWT_SECRET="dev-only-change-me-0123456789abcdef0123456789"

# Email. Dev: Mailpit (http://localhost:8025). Production: Resend SMTP
# smtp://resend:<RESEND_API_KEY>@smtp.resend.com:587
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Slotwise <no-reply@slotwise.test>"

# Where invite links point. {slug} is replaced with the institute slug.
WEB_URL_TEMPLATE="http://{slug}.localhost:3000"

# BullMQ queues (apps/api/src/queue). The path is the Redis database; each stream's worktree
# uses its own (scripts/stream-env.mjs), e.g. redis://localhost:6379/3 for P2T.
REDIS_URL="redis://localhost:6379"

# Python solver (services/solver). Called from background jobs only.
SOLVER_URL="http://localhost:8000"

# Timetable generation (P2T). fixture = demo-term.snapshot.json, api = GET /terms/:termId/snapshot.
# mock = demo-term.solution.json after SOLVER_MOCK_DELAY_MS, http = POST {SOLVER_URL}/v1/timetable/solve.
# Production: SNAPSHOT_SOURCE=api, SOLVER_SOURCE=http.
SNAPSHOT_SOURCE="fixture"
SOLVER_SOURCE="mock"
SOLVER_MOCK_DELAY_MS="3000"
# Chrome or Edge for timetable PDFs (puppeteer-core); empty = the usual install places. The
# API host needs Chromium installed (e.g. apt-get install chromium), or PDF downloads answer 503.
PDF_BROWSER_PATH=""

# S3-compatible storage for imports and PDFs. Local dev: the "storage" service in
# docker-compose.yml (RustFS; console http://localhost:9001). Production: your provider's
# endpoint and keys (Cloudflare R2, AWS S3, Backblaze B2 …).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="slotwise"
S3_ACCESS_KEY_ID="slotwise"
S3_SECRET_ACCESS_KEY="slotwise-dev-storage"
S3_FORCE_PATH_STYLE="true"

# Feature flags per stream (packages/shared/src/flags.ts). Unset: on in development, off in
# production. 1 = on, 0 = off.
# FLAG_UI=1
# FLAG_P2T=1
# FLAG_P4=1
# FLAG_P5=1
# FLAG_P6=1
# FLAG_P7=1

# Tests only: owner role, used to create and clean up test fixtures.
TEST_OWNER_DATABASE_URL="postgresql://slotwise:slotwise@localhost:5432/slotwise"

# Rescheduling (P4). api = read GET /terms/:termId/snapshot and GET /terms/:termId/timetable
# as the user; fixture = demo-term.snapshot.json and demo-term.published-timetable.json.
RESCHEDULE_SOURCE="api"

# "Ask Slotwise" chat assistant (Claude). Leave empty to switch it off.
ANTHROPIC_API_KEY=""

+import { describe, expect, it } from 'vitest';
+import type { AuthUser } from './can';
+import { canManagePlatform } from './platform';
+
+const platformAdmin: AuthUser = {
+  id: 'p',
+  memberships: [
+    { role: 'platform_admin', scopeType: 'platform', scopeId: null, instituteId: null },
+  ],
+};
+const instituteAdmin: AuthUser = {
+  id: 'a',
+  memberships: [
+    { role: 'institute_admin', scopeType: 'institute', scopeId: 'inst-a', instituteId: 'inst-a' },
+  ],
+};
+const universityAdmin: AuthUser = {
+  id: 'u',
+  memberships: [
+    { role: 'university_admin', scopeType: 'university', scopeId: 'univ', instituteId: 'univ' },
+  ],
+};
+
+describe('canManagePlatform', () => {
+  it('only platform admins', () => {
+    expect(canManagePlatform(platformAdmin)).toBe(true);
+    expect(canManagePlatform(instituteAdmin)).toBe(false);
+    expect(canManagePlatform(universityAdmin)).toBe(false);
+    expect(canManagePlatform({ id: 'x', memberships: [] })).toBe(false);
+  });
+
+  it('a platform role held in an institute scope does not count', () => {
+    const odd: AuthUser = {
+      id: 'o',
+      memberships: [
+        {
+          role: 'platform_admin',
+          scopeType: 'institute',
+          scopeId: 'inst-a',
+          instituteId: 'inst-a',
+        },
+      ],
+    };
+    expect(canManagePlatform(odd)).toBe(false);
+  });
+});
diff --git a/packages/shared/src/auth/platform.ts b/packages/shared/src/auth/platform.ts
new file mode 100644
index 0000000..b925d57
--- /dev/null
+++ b/packages/shared/src/auth/platform.ts
@@ -0,0 +1,16 @@
+import { can, type AuthUser, type Resource } from './can';
+
+/**
+ * An institute id no real institute has. Managing "an institute that is nobody's" is what
+ * only platform-scope memberships may do: every other scope is tied to a real institute,
+ * university or department id, so can() refuses them here.
+ */
+export const NO_INSTITUTE_ID = '00000000-0000-0000-0000-000000000000';
+
+/** The resource for platform screens (all institutes, plans, sign-ups). */
+export const PLATFORM_RESOURCE: Resource = { type: 'institute', instituteId: NO_INSTITUTE_ID };
+
+/** Platform admin check, through can() like every other permission check. */
+export function canManagePlatform(user: AuthUser): boolean {
+  return can(user, 'institute.manage', PLATFORM_RESOURCE);
+}

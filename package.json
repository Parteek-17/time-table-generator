{
  "name": "slotwise",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/init-env.mjs",
    "env:init": "node scripts/init-env.mjs",
    "dev": "turbo run dev --filter=@slotwise/web --filter=@slotwise/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:ownership": "node scripts/check-ownership.mjs",
    "stream:env": "node scripts/stream-env.mjs",
    "stream:worktree": "node scripts/new-worktree.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "db:generate": "pnpm --filter @slotwise/db generate",
    "db:migrate": "pnpm --filter @slotwise/db migrate",
    "db:deploy": "pnpm --filter @slotwise/db deploy:migrations",
    "db:seed": "pnpm --filter @slotwise/db seed",
    "db:reset": "pnpm --filter @slotwise/db reset",
    "db:validate": "pnpm --filter @slotwise/db validate",
    "db:create-stream-dbs": "node scripts/create-stream-dbs.mjs",
    "contracts:schemas": "pnpm --filter @slotwise/shared build && node scripts/contract-schemas.mjs",
    "fixtures:build": "pnpm --filter @slotwise/db fixtures:build"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}

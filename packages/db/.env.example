# Owner connection: used by Prisma migrate and the seed. Owns the tables.
# Matches docker-compose.yml (user "slotwise" is the Postgres superuser in dev).
DATABASE_URL="postgresql://slotwise:slotwise@localhost:5432/slotwise"

# App connection: the restricted "slotwise_app" role that the API and web use.
# Row-level security applies to it. Used here by the RLS test.
APP_DATABASE_URL="postgresql://slotwise_app:slotwise_app@localhost:5432/slotwise"

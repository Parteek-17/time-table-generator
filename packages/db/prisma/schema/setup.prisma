// Phase 1: institute master data (organisation, schemes, terms, calendar, groups, faculty,
// rooms, teaching assignments, imports). Owned by P1. See docs/adr/0007-phase1-data-model.md.

// ===========================================================================
// Phase 1: institute master data
// ===========================================================================
//
// Every model below is a tenant table (institute_id + RLS, see *_phase1_master_data).
// Master data is archived via deleted_at; join and child rows (periods, breaks, faculty on
// an assignment, unavailable cells) are replaced together with their parent instead.
// Scoped rows (holidays, calendar windows, extra working days, fixed slots) use scope_type
// plus exactly one matching FK column, enforced by a CHECK constraint.

enum DepartmentKind {
  teaching
  service

  @@map("department_kind")
}

enum ProgrammeLevel {
  ug
  pg
  diploma
  doctoral

  @@map("programme_level")
}

enum StudyMode {
  full_time
  part_time

  @@map("study_mode")
}

enum SchemeStatus {
  draft
  active
  retired

  @@map("scheme_status")
}

enum CourseType {
  core
  programme_elective
  open_elective
  mandatory
  audit
  lab
  project
  seminar
  training
  mooc

  @@map("course_type")
}

/// Whether tutorials/practicals are taken by the whole section or by each sub-group.
enum GroupedBy {
  section
  subgroup

  @@map("grouped_by")
}

enum TermKind {
  odd
  even

  @@map("term_kind")
}

enum TermStatus {
  planning
  active
  closed

  @@map("term_status")
}

enum EntryType {
  regular
  lateral

  @@map("entry_type")
}

enum BatchStatus {
  active
  graduated
  discontinued

  @@map("batch_status")
}

enum CalendarWindowType {
  mid_sem_exam
  orientation
  vacation
  training
  other

  @@map("calendar_window_type")
}

enum CalendarScope {
  institute
  department
  programme
  cohort
  section

  @@map("calendar_scope")
}

enum FixedSlotKind {
  mentoring
  minor_degree
  honours
  remedial
  library
  sports_ncc
  other

  @@map("fixed_slot_kind")
}

enum StudentStatus {
  active
  detained
  left

  @@map("student_status")
}

enum Designation {
  professor
  associate_professor
  assistant_professor
  lecturer
  teaching_assistant
  visiting

  @@map("designation")
}

enum Experience {
  experienced
  fresher

  @@map("experience")
}

enum RoomType {
  lecture
  tutorial
  lab
  seminar
  drawing_hall
  workshop

  @@map("room_type")
}

/// L, T, P of a course.
enum Component {
  lecture
  tutorial
  practical

  @@map("component")
}

enum AssignmentTarget {
  section
  subgroup
  elective_section

  @@map("assignment_target")
}

enum TeacherRole {
  main
  co_teacher
  ta

  @@map("teacher_role")
}

enum ImportKind {
  departments
  programmes
  batches_sections
  students
  faculty
  rooms
  courses
  holidays
  teaching_assignments
  fet

  @@map("import_kind")
}

enum ImportStatus {
  uploaded
  parsing
  mapping
  preview
  committing
  committed
  failed
  cancelled

  @@map("import_status")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

/// B.Tech, M.Tech, MBA, ... A programme without branches gets one default branch.
model Programme {
  id                   String         @id @default(uuid()) @db.Uuid
  instituteId          String         @map("institute_id") @db.Uuid
  /// e.g. BTECH
  code                 String
  /// e.g. B.Tech
  name                 String
  level                ProgrammeLevel
  mode                 StudyMode      @default(full_time)
  totalSemesters       Int            @map("total_semesters")
  /// Semester lateral-entry students join in (3 for B.Tech LEET). Null = no lateral entry.
  lateralEntrySemester Int?           @map("lateral_entry_semester")
  /// Null for programmes spanning departments (B.Tech); its branches carry the department.
  departmentId         String?        @map("department_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  institute  Institute   @relation(fields: [instituteId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  branches              Branch[]
  schemeVersions        SchemeVersion[]
  batches               Batch[]
  termCohortWindows     TermCohortWindow[]
  calendarWindows       CalendarWindow[]
  holidays              Holiday[]
  extraWorkingDays      ExtraWorkingDay[]
  fixedSlots            FixedSlot[]
  bellScheduleOverrides BellScheduleProgramme[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("programmes")
}

model Branch {
  id           String    @id @default(uuid()) @db.Uuid
  instituteId  String    @map("institute_id") @db.Uuid
  programmeId  String    @map("programme_id") @db.Uuid
  /// e.g. CSE
  code         String
  name         String
  departmentId String    @map("department_id") @db.Uuid
  /// The single branch of a programme that has no branches (MBA, BCA).
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  institute  Institute  @relation(fields: [instituteId], references: [id])
  programme  Programme  @relation(fields: [programmeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  courses CourseBranch[]
  batches Batch[]

  @@unique([programmeId, code])
  @@index([instituteId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

/// "Study Scheme 2024". Several versions run at once for different batches.
model SchemeVersion {
  id          String       @id @default(uuid()) @db.Uuid
  instituteId String       @map("institute_id") @db.Uuid
  programmeId String       @map("programme_id") @db.Uuid
  name        String
  status      SchemeStatus @default(draft)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  programme Programme @relation(fields: [programmeId], references: [id])

  courses Course[]
  batches Batch[]

  @@unique([programmeId, name])
  @@index([instituteId])
  @@map("scheme_versions")
}

/// A course of a scheme version in one semester. No branches = common to every branch.
model Course {
  id                   String     @id @default(uuid()) @db.Uuid
  instituteId          String     @map("institute_id") @db.Uuid
  schemeVersionId      String     @map("scheme_version_id") @db.Uuid
  semester             Int
  /// e.g. CS301
  code                 String
  title                String
  /// e.g. DS, OOP
  shortName            String     @map("short_name")
  /// L periods per week.
  lectures             Int        @default(0)
  /// T periods per week.
  tutorials            Int        @default(0)
  /// P periods per week.
  practicals           Int        @default(0)
  /// Null = L + T + P/2 (credits() in packages/shared). Set only to override.
  creditsOverride      Decimal?   @map("credits_override") @db.Decimal(4, 1)
  syllabusHours        Int?       @map("syllabus_hours")
  type                 CourseType @default(core)
  /// e.g. Elective-IV. Courses with the same group run in parallel.
  electiveGroup        String?    @map("elective_group")
  offeringDepartmentId String     @map("offering_department_id") @db.Uuid
  /// Null = lecture room for L/T, lab for P.
  roomType             RoomType?  @map("room_type")
  /// e.g. "Software lab"
  labCategory          String?    @map("lab_category")
  labBlockLength       Int        @default(2) @map("lab_block_length")
  /// False for MOOCs, training and project-only courses: no timetable slot.
  isScheduled          Boolean    @default(true) @map("is_scheduled")
  tutorialBy           GroupedBy  @default(subgroup) @map("tutorial_by")
  practicalBy          GroupedBy  @default(subgroup) @map("practical_by")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  institute          Institute     @relation(fields: [instituteId], references: [id])
  schemeVersion      SchemeVersion @relation(fields: [schemeVersionId], references: [id])
  offeringDepartment Department    @relation(fields: [offeringDepartmentId], references: [id])

  branches            CourseBranch[]
  electiveSections    ElectiveSection[]
  teachingAssignments TeachingAssignment[]
  subjectMentors      SubjectMentor[]

  @@unique([schemeVersionId, code])
  @@index([schemeVersionId, semester])
  @@index([instituteId])
  @@map("courses")
}

model CourseBranch {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid
  courseId    String @map("course_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid

  institute Institute @relation(fields: [instituteId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id])

  @@unique([courseId, branchId])
  @@index([instituteId])
  @@map("course_branches")
}

// ---------------------------------------------------------------------------
// Time
// ---------------------------------------------------------------------------

/// "2026-27". startYear drives semester derivation.
model AcademicSession {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  name        String
  startYear   Int       @map("start_year")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  terms     Term[]

  @@unique([instituteId, startYear])
  @@index([instituteId])
  @@map("academic_sessions")
}

/// ODD (Jul–Dec) or EVEN (Jan–Jun) term. At most one ACTIVE term per institute (partial index).
model Term {
  id              String     @id @default(uuid()) @db.Uuid
  instituteId     String     @map("institute_id") @db.Uuid
  sessionId       String     @map("session_id") @db.Uuid
  kind            TermKind
  /// e.g. July–Dec 2026
  label           String
  startDate       DateTime   @map("start_date") @db.Date
  endDate         DateTime   @map("end_date") @db.Date
  minTeachingDays Int        @default(90) @map("min_teaching_days")
  status          TermStatus @default(planning)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  institute Institute       @relation(fields: [instituteId], references: [id])
  session   AcademicSession @relation(fields: [sessionId], references: [id])

  cohortWindows       TermCohortWindow[]
  calendarWindows     CalendarWindow[]
  extraWorkingDays    ExtraWorkingDay[]
  fixedSlots          FixedSlot[]
  cohorts             Cohort[]
  electiveSections    ElectiveSection[]
  teachingAssignments TeachingAssignment[]
  subjectMentors      SubjectMentor[]
  timetableScopes     TimetableScope[]
  importJobs          ImportJob[]
  timetableSnapshots  TimetableSnapshot[]
  timetableVersions   TimetableVersion[]
  solveJobs           SolveJob[]
  disruptions         Disruption[]
  cancellations       Cancellation[]
  makeUps             MakeUp[]

  @@unique([sessionId, kind])
  @@index([instituteId])
  @@map("terms")
}

/// When a group of cohorts teaches in a term (first year and LEET start later).
model TermCohortWindow {
  id                String     @id @default(uuid()) @db.Uuid
  instituteId       String     @map("institute_id") @db.Uuid
  termId            String     @map("term_id") @db.Uuid
  programmeId       String     @map("programme_id") @db.Uuid
  /// Empty = every semester of the programme.
  semesters         Int[]      @default([])
  /// Null = regular and lateral entry.
  entryType         EntryType? @map("entry_type")
  teachingStart     DateTime   @map("teaching_start") @db.Date
  prepHolidaysStart DateTime?  @map("prep_holidays_start") @db.Date
  prepHolidaysEnd   DateTime?  @map("prep_holidays_end") @db.Date
  endSemExamStart   DateTime?  @map("end_sem_exam_start") @db.Date
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  term      Term      @relation(fields: [termId], references: [id])
  programme Programme @relation(fields: [programmeId], references: [id])

  @@index([termId])
  @@index([instituteId])
  @@map("term_cohort_windows")
}

/// Mid-sem exam weeks, orientation, vacation, training: dates with no regular teaching.
model CalendarWindow {
  id           String             @id @default(uuid()) @db.Uuid
  instituteId  String             @map("institute_id") @db.Uuid
  termId       String             @map("term_id") @db.Uuid
  type         CalendarWindowType
  label        String
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  scopeType    CalendarScope      @default(institute) @map("scope_type")
  departmentId String?            @map("department_id") @db.Uuid
  programmeId  String?            @map("programme_id") @db.Uuid
  cohortId     String?            @map("cohort_id") @db.Uuid
  sectionId    String?            @map("section_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  institute  Institute   @relation(fields: [instituteId], references: [id])
  term       Term        @relation(fields: [termId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  programme  Programme?  @relation(fields: [programmeId], references: [id])
  cohort     Cohort?     @relation(fields: [cohortId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])

  @@index([termId])
  @@index([instituteId])
  @@map("calendar_windows")
}

/// One day or a range (endDate = startDate for one day).
model Holiday {
  id           String        @id @default(uuid()) @db.Uuid
  instituteId  String        @map("institute_id") @db.Uuid
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  name         String
  scopeType    CalendarScope @default(institute) @map("scope_type")
  departmentId String?       @map("department_id") @db.Uuid
  programmeId  String?       @map("programme_id") @db.Uuid
  cohortId     String?       @map("cohort_id") @db.Uuid
  sectionId    String?       @map("section_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  institute  Institute   @relation(fields: [instituteId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  programme  Programme?  @relation(fields: [programmeId], references: [id])
  cohort     Cohort?     @relation(fields: [cohortId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])

  @@index([instituteId, startDate])
  @@map("holidays")
}

/// A non-working day made a teaching day, e.g. "Sat 12 Sep runs Monday's timetable".
model ExtraWorkingDay {
  id             String        @id @default(uuid()) @db.Uuid
  instituteId    String        @map("institute_id") @db.Uuid
  termId         String        @map("term_id") @db.Uuid
  date           DateTime      @db.Date
  followsWeekday Int           @map("follows_weekday")
  scopeType      CalendarScope @default(institute) @map("scope_type")
  departmentId   String?       @map("department_id") @db.Uuid
  programmeId    String?       @map("programme_id") @db.Uuid
  cohortId       String?       @map("cohort_id") @db.Uuid
  sectionId      String?       @map("section_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  institute  Institute   @relation(fields: [instituteId], references: [id])
  term       Term        @relation(fields: [termId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  programme  Programme?  @relation(fields: [programmeId], references: [id])
  cohort     Cohort?     @relation(fields: [cohortId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])

  @@index([termId])
  @@index([instituteId])
  @@map("extra_working_days")
}

/// Period times are the source of truth; breaks must match the gaps between periods
/// (validateBellSchedule() in packages/shared). One default per institute (partial index).
model BellSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  name        String
  /// ISO weekdays, e.g. [1, 2, 3, 4, 5].
  workingDays Int[]     @map("working_days")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute  Institute               @relation(fields: [instituteId], references: [id])
  periods    BellPeriod[]
  breaks     BellBreak[]
  programmes BellScheduleProgramme[]

  @@index([instituteId])
  @@map("bell_schedules")
}

model BellPeriod {
  id             String @id @default(uuid()) @db.Uuid
  instituteId    String @map("institute_id") @db.Uuid
  bellScheduleId String @map("bell_schedule_id") @db.Uuid
  /// 1-based.
  index          Int
  /// e.g. P1
  label          String
  startMinute    Int    @map("start_minute")
  endMinute      Int    @map("end_minute")

  institute    Institute    @relation(fields: [instituteId], references: [id])
  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)

  @@unique([bellScheduleId, index])
  @@index([instituteId])
  @@map("bell_periods")
}

model BellBreak {
  id               String @id @default(uuid()) @db.Uuid
  instituteId      String @map("institute_id") @db.Uuid
  bellScheduleId   String @map("bell_schedule_id") @db.Uuid
  /// e.g. Lunch
  label            String
  afterPeriodIndex Int    @map("after_period_index")
  minutes          Int

  institute    Institute    @relation(fields: [instituteId], references: [id])
  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)

  @@unique([bellScheduleId, afterPeriodIndex])
  @@index([instituteId])
  @@map("bell_breaks")
}

/// A programme (optionally only some semesters, e.g. first year) using a non-default schedule.
model BellScheduleProgramme {
  id             String @id @default(uuid()) @db.Uuid
  instituteId    String @map("institute_id") @db.Uuid
  bellScheduleId String @map("bell_schedule_id") @db.Uuid
  programmeId    String @map("programme_id") @db.Uuid
  /// Empty = every semester.
  semesters      Int[]  @default([])

  institute    Institute    @relation(fields: [instituteId], references: [id])
  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)
  programme    Programme    @relation(fields: [programmeId], references: [id])

  @@unique([bellScheduleId, programmeId])
  @@index([instituteId])
  @@map("bell_schedule_programmes")
}

/// Mentoring, minor degree, remedial, library, sports/NCC: blocked before anything else.
model FixedSlot {
  id               String        @id @default(uuid()) @db.Uuid
  instituteId      String        @map("institute_id") @db.Uuid
  termId           String        @map("term_id") @db.Uuid
  kind             FixedSlotKind
  label            String
  weekday          Int
  startPeriodIndex Int           @map("start_period_index")
  /// Inclusive.
  endPeriodIndex   Int           @map("end_period_index")
  scopeType        CalendarScope @default(institute) @map("scope_type")
  departmentId     String?       @map("department_id") @db.Uuid
  programmeId      String?       @map("programme_id") @db.Uuid
  cohortId         String?       @map("cohort_id") @db.Uuid
  sectionId        String?       @map("section_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  institute  Institute          @relation(fields: [instituteId], references: [id])
  term       Term               @relation(fields: [termId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  programme  Programme?         @relation(fields: [programmeId], references: [id])
  cohort     Cohort?            @relation(fields: [cohortId], references: [id])
  section    Section?           @relation(fields: [sectionId], references: [id])
  faculty    FixedSlotFaculty[]

  @@index([termId])
  @@index([instituteId])
  @@map("fixed_slots")
}

model FixedSlotFaculty {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid
  fixedSlotId String @map("fixed_slot_id") @db.Uuid
  facultyId   String @map("faculty_id") @db.Uuid

  institute Institute @relation(fields: [instituteId], references: [id])
  fixedSlot FixedSlot @relation(fields: [fixedSlotId], references: [id], onDelete: Cascade)
  faculty   Faculty   @relation(fields: [facultyId], references: [id])

  @@unique([fixedSlotId, facultyId])
  @@index([instituteId])
  @@map("fixed_slot_faculty")
}

// ---------------------------------------------------------------------------
// People and groups
// ---------------------------------------------------------------------------

/// Students admitted to one branch in one year by one entry route.
model Batch {
  id              String      @id @default(uuid()) @db.Uuid
  instituteId     String      @map("institute_id") @db.Uuid
  programmeId     String      @map("programme_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  admissionYear   Int         @map("admission_year")
  entryType       EntryType   @default(regular) @map("entry_type")
  schemeVersionId String      @map("scheme_version_id") @db.Uuid
  status          BatchStatus @default(active)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  institute     Institute     @relation(fields: [instituteId], references: [id])
  programme     Programme     @relation(fields: [programmeId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  schemeVersion SchemeVersion @relation(fields: [schemeVersionId], references: [id])

  cohorts  Cohort[]
  students Student[]

  @@unique([branchId, admissionYear, entryType])
  @@index([instituteId])
  @@map("batches")
}

/// A batch in a term. A lateral-entry cohort can join the sections of the regular cohort
/// (joinsCohortId) instead of having sections of its own (ADR 0007).
model Cohort {
  id                 String    @id @default(uuid()) @db.Uuid
  instituteId        String    @map("institute_id") @db.Uuid
  batchId            String    @map("batch_id") @db.Uuid
  termId             String    @map("term_id") @db.Uuid
  /// semesterFor() in packages/shared; stored so an admin can override it.
  semester           Int
  semesterOverridden Boolean   @default(false) @map("semester_overridden")
  /// False when the semester is industrial training or internship.
  isRunning          Boolean   @default(true) @map("is_running")
  /// e.g. D2 CSE
  displayCode        String    @map("display_code")
  joinsCohortId      String?   @map("joins_cohort_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  institute      Institute @relation(fields: [instituteId], references: [id])
  batch          Batch     @relation(fields: [batchId], references: [id])
  term           Term      @relation(fields: [termId], references: [id])
  joinsCohort    Cohort?   @relation("CohortJoin", fields: [joinsCohortId], references: [id])
  joiningCohorts Cohort[]  @relation("CohortJoin")

  sections         Section[]
  subjectMentors   SubjectMentor[]
  calendarWindows  CalendarWindow[]
  holidays         Holiday[]
  extraWorkingDays ExtraWorkingDay[]
  fixedSlots       FixedSlot[]
  timetableScopes  TimetableScopeCohort[]

  @@unique([batchId, termId])
  @@index([termId])
  @@index([instituteId])
  @@map("cohorts")
}

/// The group that attends lectures together (CS A). Sections belong to one term's cohort.
/// Strength includes students of any joining (lateral-entry) cohort.
model Section {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  cohortId    String    @map("cohort_id") @db.Uuid
  /// e.g. A
  name        String
  /// e.g. CS A
  displayName String    @map("display_name")
  strength    Int
  homeRoomId  String?   @map("home_room_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  cohort    Cohort    @relation(fields: [cohortId], references: [id])
  homeRoom  Room?     @relation(fields: [homeRoomId], references: [id])

  subGroups           SubGroup[]
  electiveSources     ElectiveSectionSource[]
  students            Student[]
  teachingAssignments TeachingAssignment[]
  calendarWindows     CalendarWindow[]
  holidays            Holiday[]
  extraWorkingDays    ExtraWorkingDay[]
  fixedSlots          FixedSlot[]

  @@unique([cohortId, name])
  @@index([instituteId])
  @@map("sections")
}

/// Part of a section for tutorials and labs (A1, A2). Strengths add up to the section's.
model SubGroup {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  sectionId   String    @map("section_id") @db.Uuid
  name        String
  strength    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  section   Section   @relation(fields: [sectionId], references: [id])

  students            Student[]
  teachingAssignments TeachingAssignment[]

  @@unique([sectionId, name])
  @@index([instituteId])
  @@map("sub_groups")
}

/// Students of one elective course regrouped from one or more regular sections
/// (possibly across branches for open electives).
model ElectiveSection {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  termId      String    @map("term_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  name        String
  strength    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  term      Term      @relation(fields: [termId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])

  sources             ElectiveSectionSource[]
  students            StudentElective[]
  teachingAssignments TeachingAssignment[]

  @@unique([termId, courseId, name])
  @@index([instituteId])
  @@map("elective_sections")
}

model ElectiveSectionSource {
  id                String @id @default(uuid()) @db.Uuid
  instituteId       String @map("institute_id") @db.Uuid
  electiveSectionId String @map("elective_section_id") @db.Uuid
  sectionId         String @map("section_id") @db.Uuid

  institute       Institute       @relation(fields: [instituteId], references: [id])
  electiveSection ElectiveSection @relation(fields: [electiveSectionId], references: [id], onDelete: Cascade)
  section         Section         @relation(fields: [sectionId], references: [id])

  @@unique([electiveSectionId, sectionId])
  @@index([instituteId])
  @@map("elective_section_sources")
}

/// Optional in Phase 1: section strengths are enough to plan a timetable.
model Student {
  id               String        @id @default(uuid()) @db.Uuid
  instituteId      String        @map("institute_id") @db.Uuid
  batchId          String        @map("batch_id") @db.Uuid
  classRollNo      String        @map("class_roll_no")
  universityRollNo String?       @map("university_roll_no")
  name             String
  email            String?
  phone            String?
  /// Section and sub-group in the current term.
  sectionId        String?       @map("section_id") @db.Uuid
  subGroupId       String?       @map("sub_group_id") @db.Uuid
  status           StudentStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  batch     Batch     @relation(fields: [batchId], references: [id])
  section   Section?  @relation(fields: [sectionId], references: [id])
  subGroup  SubGroup? @relation(fields: [subGroupId], references: [id])

  electives StudentElective[]

  @@unique([instituteId, classRollNo])
  @@index([instituteId])
  @@map("students")
}

model StudentElective {
  id                String @id @default(uuid()) @db.Uuid
  instituteId       String @map("institute_id") @db.Uuid
  studentId         String @map("student_id") @db.Uuid
  electiveSectionId String @map("elective_section_id") @db.Uuid

  institute       Institute       @relation(fields: [instituteId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  electiveSection ElectiveSection @relation(fields: [electiveSectionId], references: [id])

  @@unique([studentId, electiveSectionId])
  @@index([instituteId])
  @@map("student_electives")
}

model Faculty {
  id                String      @id @default(uuid()) @db.Uuid
  instituteId       String      @map("institute_id") @db.Uuid
  employeeCode      String      @map("employee_code")
  name              String
  /// e.g. VT, used in timetables.
  shortCode         String      @map("short_code")
  email             String?
  designation       Designation
  experience        Experience
  homeDepartmentId  String      @map("home_department_id") @db.Uuid
  /// Filled from defaultLoad(experience) in packages/shared on create; editable.
  maxPeriodsPerDay  Int         @map("max_periods_per_day")
  maxPeriodsPerWeek Int         @map("max_periods_per_week")
  /// Their login, once invited. Users are global, so one person can teach in two institutes.
  userId            String?     @map("user_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  institute      Institute  @relation(fields: [instituteId], references: [id])
  homeDepartment Department @relation(fields: [homeDepartmentId], references: [id])
  user           User?      @relation(fields: [userId], references: [id])

  /// Other departments they can teach in.
  departments    FacultyDepartment[]
  unavailability FacultyUnavailability[]
  assignments    TeachingAssignmentFaculty[]
  fixedSlots     FixedSlotFaculty[]
  mentorOf       SubjectMentor[]

  @@unique([instituteId, employeeCode])
  @@unique([instituteId, shortCode])
  @@unique([instituteId, userId])
  @@index([instituteId])
  @@map("faculty")
}

model FacultyDepartment {
  id           String @id @default(uuid()) @db.Uuid
  instituteId  String @map("institute_id") @db.Uuid
  facultyId    String @map("faculty_id") @db.Uuid
  departmentId String @map("department_id") @db.Uuid

  institute  Institute  @relation(fields: [instituteId], references: [id])
  faculty    Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([facultyId, departmentId])
  @@index([instituteId])
  @@map("faculty_departments")
}

/// One row per (weekday, period) a faculty member cannot teach.
model FacultyUnavailability {
  id          String  @id @default(uuid()) @db.Uuid
  instituteId String  @map("institute_id") @db.Uuid
  facultyId   String  @map("faculty_id") @db.Uuid
  weekday     Int
  periodIndex Int     @map("period_index")
  reason      String?

  institute Institute @relation(fields: [instituteId], references: [id])
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, weekday, periodIndex])
  @@index([instituteId])
  @@map("faculty_unavailability")
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

model Building {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  name        String
  code        String?
  floors      Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  rooms     Room[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("buildings")
}

/// Class capacity = capacityOverride ?? rows × seatsPerRow. Exam capacity is separate.
model Room {
  id                String    @id @default(uuid()) @db.Uuid
  instituteId       String    @map("institute_id") @db.Uuid
  /// e.g. G16, S214, SL-IV LAB
  code              String
  buildingId        String    @map("building_id") @db.Uuid
  /// 0 = ground floor.
  floor             Int       @default(0)
  type              RoomType
  /// e.g. ["Software lab"]
  labCategories     String[]  @default([]) @map("lab_categories")
  rows              Int?
  seatsPerRow       Int?      @map("seats_per_row")
  capacityOverride  Int?      @map("capacity_override")
  examSeatsPerBench Int?      @map("exam_seats_per_bench")
  ownerDepartmentId String?   @map("owner_department_id") @db.Uuid
  /// Any department may use it.
  isShared          Boolean   @default(true) @map("is_shared")
  /// Ground floor or reachable by lift.
  isAccessible      Boolean   @default(false) @map("is_accessible")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  institute       Institute   @relation(fields: [instituteId], references: [id])
  building        Building    @relation(fields: [buildingId], references: [id])
  ownerDepartment Department? @relation(fields: [ownerDepartmentId], references: [id])

  homeOfSections      Section[]
  teachingAssignments TeachingAssignment[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Who teaches what
// ---------------------------------------------------------------------------

/// One line of a department's subject distribution: who teaches the L, T or P of a course
/// to one section, sub-group or elective section. Exactly the target's column is set (CHECK).
model TeachingAssignment {
  id                   String           @id @default(uuid()) @db.Uuid
  instituteId          String           @map("institute_id") @db.Uuid
  termId               String           @map("term_id") @db.Uuid
  courseId             String           @map("course_id") @db.Uuid
  component            Component
  target               AssignmentTarget
  sectionId            String?          @map("section_id") @db.Uuid
  subGroupId           String?          @map("sub_group_id") @db.Uuid
  electiveSectionId    String?          @map("elective_section_id") @db.Uuid
  preferredRoomId      String?          @map("preferred_room_id") @db.Uuid
  preferredLabCategory String?          @map("preferred_lab_category")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  institute       Institute        @relation(fields: [instituteId], references: [id])
  term            Term             @relation(fields: [termId], references: [id])
  course          Course           @relation(fields: [courseId], references: [id])
  section         Section?         @relation(fields: [sectionId], references: [id])
  subGroup        SubGroup?        @relation(fields: [subGroupId], references: [id])
  electiveSection ElectiveSection? @relation(fields: [electiveSectionId], references: [id])
  preferredRoom   Room?            @relation(fields: [preferredRoomId], references: [id])

  faculty TeachingAssignmentFaculty[]

  @@index([termId, courseId])
  @@index([instituteId])
  @@map("teaching_assignments")
}

model TeachingAssignmentFaculty {
  id           String      @id @default(uuid()) @db.Uuid
  instituteId  String      @map("institute_id") @db.Uuid
  assignmentId String      @map("assignment_id") @db.Uuid
  facultyId    String      @map("faculty_id") @db.Uuid
  role         TeacherRole @default(main)

  institute  Institute          @relation(fields: [instituteId], references: [id])
  assignment TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  faculty    Faculty            @relation(fields: [facultyId], references: [id])

  @@unique([assignmentId, facultyId])
  @@index([facultyId])
  @@index([instituteId])
  @@map("teaching_assignment_faculty")
}

model SubjectMentor {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  termId      String    @map("term_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  cohortId    String    @map("cohort_id") @db.Uuid
  facultyId   String    @map("faculty_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  term      Term      @relation(fields: [termId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])
  cohort    Cohort    @relation(fields: [cohortId], references: [id])
  faculty   Faculty   @relation(fields: [facultyId], references: [id])

  @@unique([termId, courseId, cohortId])
  @@index([instituteId])
  @@map("subject_mentors")
}

// ---------------------------------------------------------------------------
// Planning and imports
// ---------------------------------------------------------------------------

/// Which running cohorts one timetable covers. Saved in Phase 1, used by the Phase 2 solver.
model TimetableScope {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  termId      String    @map("term_id") @db.Uuid
  name        String    @default("Main")
  notes       String?
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  institute Institute              @relation(fields: [instituteId], references: [id])
  term      Term                   @relation(fields: [termId], references: [id])
  createdBy User                   @relation(fields: [createdById], references: [id])
  cohorts   TimetableScopeCohort[]
  versions  TimetableVersion[]
  solveJobs SolveJob[]

  @@index([instituteId])
  @@map("timetable_scopes")
}

model TimetableScopeCohort {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid
  scopeId     String @map("scope_id") @db.Uuid
  cohortId    String @map("cohort_id") @db.Uuid

  institute Institute      @relation(fields: [instituteId], references: [id])
  scope     TimetableScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  cohort    Cohort         @relation(fields: [cohortId], references: [id])

  @@unique([scopeId, cohortId])
  @@index([instituteId])
  @@map("timetable_scope_cohorts")
}

/// One uploaded Excel/CSV/FET file going through map → preview → commit.
model ImportJob {
  id            String       @id @default(uuid()) @db.Uuid
  instituteId   String       @map("institute_id") @db.Uuid
  kind          ImportKind
  status        ImportStatus @default(uploaded)
  fileName      String       @map("file_name")
  /// Object-storage key of the uploaded file.
  fileKey       String       @map("file_key")
  /// For term-bound kinds (batches and sections, teaching assignments).
  termId        String?      @map("term_id") @db.Uuid
  /// Template column → header in the file.
  columnMapping Json         @default("{}") @map("column_mapping")
  rowCount      Int          @default(0) @map("row_count")
  /// 0..100 while parsing or committing.
  progress      Int          @default(0)
  /// { created, updated, skipped, error? }
  summary       Json         @default("{}")
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  institute Institute   @relation(fields: [instituteId], references: [id])
  term      Term?       @relation(fields: [termId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])
  rows      ImportRow[]

  @@index([instituteId, createdAt])
  @@map("import_jobs")
}

/// A parsed row, kept for the preview and inline fixes.
model ImportRow {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid
  jobId       String @map("job_id") @db.Uuid
  /// Row number in the file, as the user sees it in Excel.
  rowNumber   Int    @map("row_number")
  /// Values after column mapping and inline edits.
  data        Json
  /// [{ column, message }] in plain language.
  errors      Json   @default("[]")
  /// create | update | skip, decided by natural key at preview.
  action      String

  institute Institute @relation(fields: [instituteId], references: [id])
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([instituteId])
  @@map("import_rows")
}

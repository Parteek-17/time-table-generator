// Add models here. Relations to models in other files go as fields on YOUR models; never edit
// another file's models — file a request (docs/coordination/requests/). The one exception is
// the matching back-relation line (`timetables Timetable[]`) on the other model, which Prisma
// requires; see docs/coordination/OWNERSHIP.md.
// Every tenant table needs institute_id + an RLS policy (docs/adr/0002-tenancy-and-rls.md).

/// A one-time sign-in code for a student: roll number + code, no passwords (CLAUDE.md
/// "Access and login"; docs/adr/0070-student-one-time-code-sign-in.md).
model PortalLoginCode {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  /// hashCode(code, API_JWT_SECRET) from @slotwise/shared/portal; never the code itself.
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  /// Wrong tries so far.
  attempts    Int       @default(0)
  /// Set when the code was used, or replaced by a newer one.
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([instituteId])
  @@map("portal_login_codes")
}

/// A person's calendar subscription link (iCal). Revoked when they make a new link.
model PortalCalendarFeed {
  id          String    @id @default(uuid()) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instituteId])
  @@map("portal_calendar_feeds")
}

enum PortalLinkKind {
  section
  room

  @@map("portal_link_kind")
}

/// A public read-only link (and QR code) to a section's or room's published timetable,
/// for notice boards, classroom doors and WhatsApp groups. Anyone with the link can read it.
model PortalPublicLink {
  id          String         @id @default(uuid()) @db.Uuid
  instituteId String         @map("institute_id") @db.Uuid
  kind        PortalLinkKind
  /// Section or room id (P1's master data; no foreign key across the two kinds).
  targetId    String         @map("target_id") @db.Uuid
  /// e.g. "CS A" or "Room G16", copied when the link was made.
  label       String
  /// The timetable is read with this person's permissions; the link stops if they lose access.
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  revokedAt   DateTime?      @map("revoked_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([instituteId, kind, targetId])
  @@map("portal_public_links")
}
